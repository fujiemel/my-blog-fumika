---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";

interface Props {
	title: string;
	lang?: string;
}

const { title, lang } = Astro.props;
const pageUrl = Astro.url.href;
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(title);
---

<div
	class="card-base px-6 md:px-9 py-5 mb-6 onload-animation"
	data-share-root
	data-share-title={title}
	data-share-url={pageUrl}
>
	<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
		<span class="text-sm font-bold text-90 mr-1">
			{i18n(I18nKey.share, lang)}
		</span>

		<button
			type="button"
			data-share-action="copy"
			class="btn-regular h-8 px-3 rounded-lg text-sm flex items-center gap-1.5"
		>
			<Icon name="material-symbols:link-rounded" class="text-[1rem]" />
			{i18n(I18nKey.copyLink, lang)}
		</button>

		<button
			type="button"
			data-share-action="native"
			data-share-native
			class="btn-regular h-8 px-3 rounded-lg text-sm flex items-center gap-1.5" style="display: none"
		>
			<Icon name="material-symbols:share-rounded" class="text-[1rem]" />
			{i18n(I18nKey.share, lang)}
		</button>

		<a
			href={`https://service.weibo.com/share/share.php?url=${encodedUrl}&title=${encodedTitle}`}
			target="_blank"
			rel="noopener noreferrer"
			class="btn-regular h-8 px-3 rounded-lg text-sm flex items-center gap-1.5"
		>
			微博
		</a>

		<a
			href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
			target="_blank"
			rel="noopener noreferrer"
			class="btn-regular h-8 px-3 rounded-lg text-sm flex items-center gap-1.5"
		>
			X
		</a>
	</div>

	<span
		data-share-feedback
		class="hidden text-xs text-(--primary) mt-2 inline-block"
	>
		{i18n(I18nKey.copied, lang)}
	</span>
</div>
