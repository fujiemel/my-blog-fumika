---
import { getCollection } from "astro:content";
import { cdnImage } from "@utils/cdn";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { siteUrl } from "@utils/url-utils";
import { profileConfig, siteConfig } from "@/config";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	setOGTypeArticle?: boolean;
}

let { title, description, image, setOGTypeArticle = false } = Astro.props;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const canonicalUrl = Astro.url;

const slug = Astro.url.pathname.split("/").filter(Boolean).pop();

interface PageData {
	published?: Date | string;
	updated?: Date | string;
	tags?: string[];
	description?: string;
}

let pageData: PageData = {};
try {
	const allEntries = await getCollection("posts");
	const entry = allEntries.find((e) => e.id === slug);
	if (entry) {
		pageData = entry.data as PageData;
	}
} catch (e) {
	// silent fail if no blog/post page
}

let ogImage: string | undefined;

const defaultOgImage = siteConfig.ogImage.useDefault
	? siteUrl(siteConfig.ogImage.defaultSrc)
	: undefined;

ogImage = defaultOgImage;

if (image && typeof image === "string" && image.trim() !== "") {
	if (image.startsWith("http://") || image.startsWith("https://")) {
		ogImage = image;
	} else if (image.startsWith("media")) {
		ogImage = siteUrl(`/${image}`);
	} else if (image.startsWith("/")) {
		const cdn = cdnImage(image);
		ogImage = cdn === image ? siteUrl(image) : cdn;
	}
}

const formatDate = (date: Date | string | undefined): string | null => {
	if (!date) {
		return null;
	}
	if (date instanceof Date) {
		return formatDateToYYYYMMDD(date);
	}
	if (typeof date === "string") {
		// 纯日期字符串直接截取，带时间的交给统一格式化（按站点时区）
		return date.length >= 10 && !date.includes("T")
			? date.slice(0, 10)
			: formatDateToYYYYMMDD(new Date(date));
	}
	return null;
};

const publishedDate = formatDate(pageData.published);
const updatedDate = formatDate(pageData.updated);

const tags: string[] = pageData.tags || [];

if (!description) {
	description = pageData.description || siteConfig.subtitle || pageTitle;
}

// 摘要里可能带换行与多余空白，meta 描述统一压成单行并限制长度
description = String(description).replace(/\s+/g, " ").trim();
if (description.length > 160) {
	description = `${description.slice(0, 160)}…`;
}
if (!description) {
	description = pageTitle;
}
---

<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<meta name="author" content={profileConfig.name}>
<link rel="canonical" href={canonicalUrl} />

<meta property="og:site_name" content={siteConfig.title}>
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}

{setOGTypeArticle ? (
  <>
    <meta property="og:type" content="article" />
    {tags.map((tag: string) => (
    <meta property="article:tag" content={tag} />
    ))}
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate} />}
  </>
  ) : (
  <meta property="og:type" content="website" />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}