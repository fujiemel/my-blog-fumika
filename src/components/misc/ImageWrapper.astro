---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
}

import { Image } from "astro:assets";
import { cdnImage } from "../../utils/cdn";
import { IMAGE_PLACEHOLDER } from "../../utils/image-placeholder";
import { url } from "../../utils/url-utils";

const { id, src, alt, position = "center", basePath = "/" } = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// /image/posts|moments/... 在构建期映射到 R2，其余站内图片保持本地
const publicSrc = (() => {
	if (!isPublic) return src;
	const cdn = cdnImage(src);
	return cdn === src ? url(src) : cdn;
})();

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{jpg,jpeg,png,webp,avif,gif,svg}",
		{ import: "default" },
	);
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	}
	img = file ? await file() : undefined;
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
	<div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
	{isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle} loading="lazy" decoding="async" data-img-state="pending" data-img-placeholder />}
	{isLocal && !img && <img src={IMAGE_PLACEHOLDER} alt={alt || ""} class={imageClass} style={imageStyle} data-img-state="error" data-img-placeholder />}
	{!isLocal && <img src={publicSrc} alt={alt || ""} class={imageClass} style={imageStyle} loading="lazy" decoding="async" data-img-state="pending" data-img-placeholder />}
</div>
