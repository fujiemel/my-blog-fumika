---
import { commentConfig } from "@/config";
import Waline from "./Waline.astro";

interface Props {
	lang?: string;
}

// 未配置 serverURL 时 Waline 自身不渲染内容
const enabled = Boolean(commentConfig.waline?.serverURL?.trim());
---

{
	enabled && (
		<div class="card-base p-6 mb-4">
			<Waline />
		</div>
	)
}
