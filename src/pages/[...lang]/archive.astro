---
import ArchivePanel from "@components/ArchivePanel.svelte";
import { DEFAULT_LANG, SUPPORTED_LANG } from "@constants/constants";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import type { GetStaticPaths } from "astro";
import {
	getMomentsWithExcerpt,
	getSortedPostsList,
} from "../../utils/content-utils";

export const getStaticPaths = (async () => {
	return SUPPORTED_LANG.map((lang) => ({
		params: {
			lang: lang === DEFAULT_LANG ? undefined : lang,
		},
		props: { lang },
	}));
}) satisfies GetStaticPaths;

const { lang } = Astro.props;
const sortedPostsList = await getSortedPostsList(lang);
// 说说与文章混排进同一条时间轴
const sortedMoments = await getMomentsWithExcerpt();
---

<MainGridLayout title={i18n(I18nKey.archive, lang)} lang={lang}>
    <h1 class="sr-only">{i18n(I18nKey.archive, lang)}</h1>
    <ArchivePanel
        sortedPosts={sortedPostsList}
        sortedMoments={sortedMoments}
        lang={lang}
        client:load
    />
</MainGridLayout>
