{
	"name": "fumika",
	"type": "module",
	"version": "0.1.0",
	"scripts": {
		"dev": "astro dev",
		"build": "node scripts/image-sizes.mjs && astro build && pagefind --site dist && node scripts/check-dist.mjs",
		"release": "node --env-file=.env scripts/sync-images.mjs && node scripts/image-sizes.mjs && astro build && pagefind --site dist && node --env-file=.env scripts/check-dist.mjs",
		"sync-images": "node --env-file=.env scripts/sync-images.mjs",
		"pull-images": "node --env-file=.env scripts/pull-images.mjs",
		"check:dist": "node scripts/check-dist.mjs",
		"preview": "astro preview",
		"astro": "astro",
		"check": "pnpm run astro-check && pnpm run type-check && pnpm run svelte-check",
		"astro-check": "astro check",
		"type-check": "tsc --noEmit",
		"svelte-check": "svelte-check --tsconfig tsconfig.json",
		"new-post": "node scripts/new-content.js post",
		"new-moment": "node scripts/new-content.js moment",
		"format": "biome format --write ./src",
		"lint": "biome check --write ./src",
		"test": "vitest",
		"test-coverage": "vitest run --coverage",
		"preinstall": "npx only-allow pnpm",
		"local-prepare": "husky",
		"predev": "node scripts/image-sizes.mjs",
		"images:sizes": "node scripts/image-sizes.mjs"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.5",
		"@astrojs/partytown": "^2.1.9",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/svelte": "9.0.1",
		"@expressive-code/core": "^0.44.3",
		"@expressive-code/plugin-collapsible-sections": "^0.44.3",
		"@expressive-code/plugin-line-numbers": "^0.44.3",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/noto-sans-sc": "^5.3.1",
		"@fontsource/roboto": "^5.3.0",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/fa6-regular": "^1.2.4",
		"@iconify-json/fa6-solid": "^1.2.4",
		"@iconify-json/material-symbols": "^1.2.97",
		"@iconify/svelte": "^5.2.3",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@waline/client": "^3.16.1",
		"astro": "7.2.10",
		"astro-expressive-code": "^0.44.3",
		"astro-icon": "^1.2.0",
		"hastscript": "^9.0.1",
		"katex": "^0.18.6",
		"markdown-it": "^15.0.3",
		"mdast-util-to-string": "^4.0.0",
		"mermaid": "11.17.2",
		"overlayscrollbars": "^2.16.0",
		"pagefind": "^1.5.2",
		"photoswipe": "^5.4.4",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^4.0.0",
		"remark-directive-rehype": "^1.0.0",
		"remark-github-admonitions-to-directives": "^2.1.0",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.17.7",
		"sass": "^1.104.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"tailwindcss": "^4.3.3",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/ts-plugin": "^1.10.12",
		"@aws-sdk/client-s3": "^3.1160.0",
		"@biomejs/biome": "2.5.12",
		"@lhci/cli": "^0.15.1",
		"@rollup/plugin-yaml": "^5.0.1",
		"@types/hast": "^3.0.5",
		"@types/markdown-it": "^14.2.0",
		"@types/mdast": "^4.0.4",
		"@types/sanitize-html": "^2.16.1",
		"@vitest/coverage-v8": "4.1.12",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.0",
		"svelte-check": "^4.7.7",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	},
	"packageManager": "pnpm@11.25.0"
}
